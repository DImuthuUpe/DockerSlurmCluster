UBUNTU_BASE=ubuntu:26.04
IMAGE_TAG=latest
SLURM_CPUS_ON_NODE=8
# Prefix for container/hostnames; change per-instance (along with -p) to run multiple clusters at once
CLUSTER_NAME=slurm
# Host port (bound to 127.0.0.1) forwarded to sshd on the frontend; change per-instance to run multiple clusters at once
SSH_PORT=2222
